// Marketplace schema — PostgreSQL via prisma.config.ts DATABASE_URL

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  SUBADMIN
  ASSISTANT
  SALES
  VENDOR
  CUSTOMER
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VendorRestriction {
  NONE
  SUSPEND_SELLING
  SUSPEND_PAYOUTS
  FULL_SUSPEND
}

enum ProductApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum OrderStatus {
  /// Cash on delivery, waiting for the buyer (or staff) to confirm.
  PLACED
  /// Online payment started at a gateway, not yet confirmed.
  PENDING_PAYMENT
  /// Cash on delivery confirmed; ready to ship, cash collected on delivery.
  CONFIRMED
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  /// Card via Stripe Checkout (UAE).
  STRIPE
  PAYPAL
  TABBY
  CASH_ON_DELIVERY
  /// JazzCash mobile wallet (Pakistan).
  JAZZCASH
  /// Easypaisa mobile account (Pakistan).
  EASYPAISA
  /// Debit/credit card through a Pakistani gateway (JazzCash or Easypaisa).
  CARD
}

enum LedgerAccountType {
  PLATFORM
  VENDOR_WALLET
  ESCROW
  FEES
}

enum NotificationCampaignType {
  ABANDONED_CART
  BROWSE_INTENT
  PRICE_DROP
  PROMO
}

/// Countries we sell in. Vendors belong to one market; orders are placed in one market's currency.
enum Market {
  PK
  AE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  phone         String?
  name          String?
  image         String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  banned        Boolean   @default(false)
  lastLoginIp   String?
  lastLoginDevice String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendorProfile       VendorProfile?
  salesProfile        SalesProfile?
  notifications       UserNotification[]
  supportTickets      SupportTicket[]      @relation("UserTickets")
  auditLogs           AuditLog[]
  cart                Cart?
  orders              Order[]              @relation("CustomerOrders")
  addresses           Address[]
  productViews        ProductViewEvent[]
  riskFlags           RiskFlag[]
  createdSalesProfiles SalesProfile[]      @relation("CreatedSalesBy")
  approvedProducts    Product[]           @relation("ProductApprovers")
  favorites           Favorite[]
  rewardAccounts      RewardAccount[]
}

model VendorProfile {
  id                   String            @id @default(cuid())
  userId               String            @unique
  storeName            String
  /// Name shown to shoppers instead of storeName (set by admins, e.g. to keep a supplier private).
  displayName          String?
  /// Public store URL: /store/<slug>. Set when the store is created and kept if the name changes.
  slug                 String?           @unique
  phone                String
  logoUrl              String?
  bannerUrl            String?
  addressLine1         String
  addressLine2         String?
  city                 String?
  region               String?
  postalCode           String?
  market               Market            @default(PK)
  /// CNIC (PK) or Emirates ID (AE)
  nationalId           String?
  /// NTN (PK) or trade licence number (AE)
  businessRegNo        String?
  /// STRN (PK sales tax) or TRN (AE VAT); empty when not tax-registered
  taxRegNo             String?
  kycStatus            KycStatus         @default(PENDING)
  verificationNotes    String?
  commissionOverrideBps Int?
  restriction          VendorRestriction @default(NONE)
  suspendedReason      String?
  complaintsCount      Int               @default(0)
  refundsCount         Int               @default(0)
  /// Shown under "Top sellers" on the home page.
  isTopSeller          Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  products        Product[]        @relation("VendorProducts")
  ledgerAccount   LedgerAccount?
  withdrawals     WithdrawalRequest[]
  orderItems      OrderItem[]
}

model SalesProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  createdById  String?
  employeeCode String?
  createdAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("CreatedSalesBy", fields: [createdById], references: [id])
  products  Product[] @relation("SalesUploadedProducts")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  /// Shown on the category page and used as its search description.
  description String?
  /// Tile image (512×512 WebP made from the admin's upload); a placeholder is shown when empty.
  imageUrl    String?
  /// Listed in the home page "Shop by category" row, lowest homeOrder first.
  showOnHome  Boolean   @default(false)
  homeOrder   Int       @default(0)
  parentId    String?
  parent      Category? @relation("CatTree", fields: [parentId], references: [id])
  children    Category[] @relation("CatTree")
  attributeDefs CategoryAttribute[]
  products    Product[]
  commissionRules CommissionRule[]
}

model CategoryAttribute {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  key        String
  dataType   String
  required   Boolean  @default(false)
  options    String[] @default([])
  /// Shopper chooses a value (e.g. Size): products list the values they offer, with stock per combination.
  isVariant  Boolean  @default(false)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
}

model Product {
  id                  String                @id @default(cuid())
  slug                String                @unique
  name                String
  description         String?
  /// The supplier's original text, kept as input for AI-written descriptions (never shown to shoppers).
  sourceDescription   String?
  /// When the current description was written by AI.
  descriptionWrittenAt DateTime?
  basePrice           Decimal               @db.Decimal(12, 2)
  /// Optional "was" price shown crossed out; only shown when above the selling price.
  compareAtPrice      Decimal?              @db.Decimal(12, 2)
  /// Sales tax / VAT rate already included in basePrice (prices are tax-inclusive).
  salesTaxBps         Int                   @default(0)
  sku                 String?
  stock               Int                   @default(0)
  /// false: shoppers see only "In stock", never the quantity.
  showStockCount      Boolean               @default(true)
  /// Average of published reviews (0 when none) and their count, kept in sync by src/lib/reviews.ts.
  ratingAvg           Float                 @default(0)
  ratingCount         Int                   @default(0)
  categoryId          String
  vendorId            String
  salesPersonId       String?
  approvalStatus      ProductApprovalStatus @default(PENDING_REVIEW)
  rejectionReason     String?
  approvedById        String?
  approvedAt          DateTime?
  displayOnStorefront Boolean               @default(false)
  availableForSale    Boolean               @default(false)
  featuredPriority    Int                   @default(0)
  /// "Trending" on the home page (named isHot before the rename); only approved products.
  isHot               Boolean               @default(false)
  /// "Most Popular" on the home page; only approved products.
  isPopular           Boolean               @default(false)
  zoneTags            String[]              @default([])
  /// Supplier the listing was imported from (e.g. "markaz"); null for listings made here.
  source              String?
  /// The supplier's product id, so re-imports update instead of duplicating.
  sourceRef           String?
  dynamicPriceRule    Json?
  metadata            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id])
  vendor      VendorProfile  @relation("VendorProducts", fields: [vendorId], references: [id])
  salesPerson SalesProfile?  @relation("SalesUploadedProducts", fields: [salesPersonId], references: [id])
  approvedBy  User?          @relation("ProductApprovers", fields: [approvedById], references: [id])
  images      ProductImage[]
  videos      ProductVideo[]
  orderItems  OrderItem[]
  views       ProductViewEvent[]
  cartItems   CartItem[]
  favorites   Favorite[]
  variants    ProductVariant[]
  recommendationEvents RecommendationEvent[]
  reviews             ProductReview[]

  @@unique([source, sourceRef])
}

/// One buyable combination of a product's variant attributes, e.g. Size 41 / Yellow.
/// When a product has variants, Product.stock is kept equal to the sum of their stock.
model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  /// Chosen value per variant attribute key, e.g. {"size": "41", "color": "Yellow"}.
  options    Json
  /// Canonical form of `options` ("color=Yellow;size=41"), unique per product.
  optionsKey String
  /// Overrides Product.basePrice when set (tax-inclusive, like basePrice).
  price      Decimal? @db.Decimal(12, 2)
  stock      Int      @default(0)
  sku        String?

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@unique([productId, optionsKey])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  /// Colour this photo shows (a value of the colour variant attribute); null = all colours.
  color     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  sessionId  String?  @unique
  guestEmail String?
  guestPhone String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  /// variantId or "" — non-null so the unique key also holds for products without variants.
  variantKey String @default("")
  quantity  Int
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantKey])
}

/// Saved products. Guests are keyed by the cart session cookie, like carts, and merged on login.
model Favorite {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  productId String
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([sessionId, productId])
}

/// A customer's reward points in one market (a point is worth a different amount per currency).
model RewardAccount {
  id        String   @id @default(cuid())
  userId    String
  market    Market
  /// Can go negative if points earned on an order are reversed after being spent.
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries RewardEntry[]

  @@unique([userId, market])
}

/// Points history. At most one entry of each kind per order, so lifecycle hooks are idempotent.
model RewardEntry {
  id        String   @id @default(cuid())
  accountId String
  /// Signed: earned/refunded are positive, redeemed/reversed negative.
  points    Int
  /// EARNED (order delivered) | REDEEMED (spent at checkout) | REDEEM_REFUNDED | EARN_REVERSED
  kind      String
  orderId   String?
  createdAt DateTime @default(now())

  account RewardAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([accountId, createdAt])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String
  country    String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  /// Amounts are in this market's currency (see src/lib/markets.ts).
  market          Market
  customerId      String?
  customerEmail   String
  customerPhone   String?
  status          OrderStatus   @default(PLACED)
  paymentMethod   PaymentMethod
  /// Gateway that processes an online payment: "stripe" | "jazzcash" | "easypaisa".
  paymentProvider String?
  /// Gateway reference: Stripe session/PaymentIntent id, JazzCash pp_TxnRefNo, Easypaisa orderRefNum.
  paymentIntentId String?
  /// Cart to empty once an online payment succeeds (left intact if the buyer abandons payment).
  checkoutCartId  String?
  /// Cash on delivery confirmation: sha256 of the link token sent to the buyer.
  confirmTokenHash      String?   @unique
  confirmTokenExpiresAt DateTime?
  /// Twilio SID of the WhatsApp confirmation message, to fall back to SMS if it fails.
  confirmMessageSid     String?   @unique
  confirmedAt           DateTime?
  /// "customer" or "staff:<userId>"
  confirmedVia          String?
  courier               String?
  trackingNumber        String?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  subtotal        Decimal       @db.Decimal(12, 2)
  taxTotal        Decimal       @db.Decimal(12, 2)
  shipping        Decimal       @db.Decimal(12, 2) @default(0)
  total           Decimal       @db.Decimal(12, 2)
  shippingAddress Json?
  disputeReason   String?
  /// Reward points spent on this order and the discount they gave (funded by the platform).
  pointsRedeemed  Int           @default(0)
  pointsDiscount  Decimal       @db.Decimal(12, 2) @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer        User?            @relation("CustomerOrders", fields: [customerId], references: [id])
  items           OrderItem[]
  ledgerMovements LedgerMovement[]
  refunds         Refund[]
  events          OrderEvent[]
}

/// Status history of an order: every transition, with who made it and why.
model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  /// "system", "customer", or "staff:<userId>"
  actor     String
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model OrderItem {
  id                   String  @id @default(cuid())
  orderId              String
  productId            String
  vendorId             String
  title                String
  unitPrice            Decimal @db.Decimal(12, 2)
  quantity             Int
  taxBps               Int
  commissionBpsApplied Int     @default(0)
  /// Variant bought, if any. No foreign key: order history survives the variant being removed.
  variantId            String?
  /// e.g. "Size: 41 · Color: Yellow" (also appended to `title`).
  variantLabel         String?

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])
  vendor  VendorProfile @relation(fields: [vendorId], references: [id])
  review  ProductReview?

  @@index([productId])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  type      LedgerAccountType
  vendorId  String?           @unique
  label     String?
  createdAt DateTime          @default(now())

  vendor        VendorProfile?   @relation(fields: [vendorId], references: [id])
  outMovements  LedgerMovement[] @relation("FromAccount")
  inMovements   LedgerMovement[] @relation("ToAccount")
}

model LedgerMovement {
  id            String   @id @default(cuid())
  fromAccountId String
  toAccountId   String
  amountCents   Int
  currency      String
  kind          String
  orderId       String?
  description   String?
  createdAt     DateTime @default(now())

  fromAccount LedgerAccount @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   LedgerAccount @relation("ToAccount", fields: [toAccountId], references: [id])
  order       Order?        @relation(fields: [orderId], references: [id])
}

model WithdrawalRequest {
  id             String    @id @default(cuid())
  vendorId       String
  amountCents    Int
  status         String    @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  vendor VendorProfile @relation(fields: [vendorId], references: [id])
}

model CommissionRule {
  id         String   @id @default(cuid())
  name       String
  ruleType   String
  bps        Int
  categoryId String?
  vendorId   String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  category Category? @relation(fields: [categoryId], references: [id])
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  percentOff     Int?
  amountOffCents Int?
  active         Boolean   @default(true)
  expiresAt      DateTime?
  maxUses        Int?
  usedCount      Int       @default(0)
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  status    String   @default("ACTIVE")
  source    String?
  createdAt DateTime @default(now())
}

model UserNotification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationCampaignLog {
  id          String                   @id @default(cuid())
  type        NotificationCampaignType
  targetEmail String?
  targetPhone String?
  payload     Json?
  sentAt      DateTime                 @default(now())
}

model ProductViewEvent {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  sessionId String?
  zone      String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
}

enum RecommendationEventKind {
  SHOWN
  CLICK
  ADD
}

/// What happened to a "You may also like" suggestion, to measure which signals sell.
model RecommendationEvent {
  id        String                  @id @default(cuid())
  kind      RecommendationEventKind
  productId String
  /// Main signal behind the suggestion, e.g. "bought_together", "viewed" (see src/lib/recommendations.ts).
  reason    String
  /// Where it was shown, e.g. "cart".
  placement String
  userId    String?
  sessionId String?
  createdAt DateTime                @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  body      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  user User @relation("UserTickets", fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model RiskFlag {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  score     Int
  detail    Json?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Refund {
  id          String   @id @default(cuid())
  orderId     String
  amountCents Int
  partial     Boolean  @default(false)
  reason      String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

/// A supplier file uploaded in Admin › Products › Import: previewed first, then imported in the background.
model ImportJob {
  id           String    @id @default(cuid())
  source       String
  fileName     String
  /// preview | running | done | failed
  status       String    @default("preview")
  vendorId     String
  stockPerItem Int
  showStockCount Boolean @default(true)
  /// Write AI descriptions for the new products once the import finishes.
  writeDescriptions Boolean @default(false)
  createdById  String?
  /// Products parsed from the file, so the import doesn't need the upload again.
  products     Json
  /// Dry-run outcome per product, shown before importing.
  preview      Json
  /// Real outcome per product, filled while importing.
  results      Json?
  total        Int
  processed    Int       @default(0)
  created      Int       @default(0)
  updated      Int       @default(0)
  skipped      Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  startedAt    DateTime?
  finishedAt   DateTime?

  @@index([createdAt])
}

/// The store's own rotating images behind the home page hero (Admin › Banners).
model HeroBanner {
  id        String    @id @default(cuid())
  imageUrl  String
  alt       String
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  /// Optional display window; empty means always.
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

/// A company that buys advertising time (Admin › Advertising).
model Advertiser {
  id          String     @id @default(cuid())
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime   @default(now())
  banners     AdBanner[]
}

/// One paid banner booking: an image shown in one section between two dates.
model AdBanner {
  id            String     @id @default(cuid())
  advertiserId  String
  /// home_top | home_bottom | footer | cart | checkout
  placement     String
  imageUrl      String
  alt           String
  /// Where a click goes: the advertiser's site or a page here.
  linkUrl       String?
  startsAt      DateTime
  endsAt        DateTime
  /// Paused bookings don't show, even inside their dates.
  isActive      Boolean    @default(true)
  /// Whole PKR, for the owner's records (no online payment).
  price         Int?
  /// unpaid | partial | paid
  paymentStatus String     @default("unpaid")
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  advertiser    Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  stats         AdStat[]

  @@index([placement, startsAt, endsAt])
}

/// Views and clicks of a booking per day (Pakistan time), for advertiser reports.
model AdStat {
  id          String   @id @default(cuid())
  adBannerId  String
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)
  adBanner    AdBanner @relation(fields: [adBannerId], references: [id], onDelete: Cascade)

  @@unique([adBannerId, day])
}

/// Admin-written content: info pages (/about, /return-policy…) and blog posts (/blog/<slug>).
model ContentPage {
  id             String    @id @default(cuid())
  /// "page" or "post"
  kind           String
  slug           String
  title          String
  /// Markdown (headings, lists, links, bold); raw HTML is not rendered.
  body           String
  excerpt        String?
  coverImageUrl  String?
  /// "draft" or "published"
  status         String    @default("draft")
  seoTitle       String?
  seoDescription String?
  /// Pages: listed in the footer's information links.
  showInFooter   Boolean   @default(false)
  footerOrder    Int       @default(0)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([kind, slug])
  @@index([kind, status, publishedAt])
}

/// A verified buyer's review: one per delivered order line.
model ProductReview {
  id          String   @id @default(cuid())
  productId   String
  orderItemId String   @unique
  orderId     String
  userId      String?
  /// 1 to 5 stars.
  rating      Int
  title       String?
  body        String
  /// Shown publicly, e.g. "Ayesha K."
  authorName  String
  /// published | hidden (hidden by staff)
  status      String   @default("published")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([productId, status, createdAt])
  @@index([status, createdAt])
}
