# PostgreSQL — run migration after DB is up:
#   npm run db:migrate
#   npm run db:seed
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marketplace?schema=public"

# Auth.js / NextAuth (v5 uses AUTH_SECRET)
AUTH_SECRET="change-me-to-a-long-random-string-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Product image/video uploads are stored on local disk here (served at /api/media/…).
# Needs a persistent disk; on serverless hosts switch src/lib/storage.ts to object storage.
UPLOAD_DIR="./uploads"

# Company alerts (order + vendor purchase notifications)
COMPANY_NOTIFY_EMAIL="owner@example.com"
COMPANY_NOTIFY_PHONE="+10000000000"

# Email (SMTP) — optional; logs to console if unset
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Marketplace <noreply@example.com>"

# SMS + WhatsApp — Twilio optional; messages are logged to the console if unset
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# SMS sender (Pakistan needs a PTA-registered sender ID for reliable delivery)
TWILIO_FROM=""
# WhatsApp sender number (without the "whatsapp:" prefix), e.g. +14155238886 for the sandbox
TWILIO_WHATSAPP_FROM=""
# Approved WhatsApp template for COD confirmation; variables {{1}} order no, {{2}} total, {{3}} link.
# Without it, a plain message is sent (only works in the sandbox / a 24h customer session).
TWILIO_WHATSAPP_COD_CONTENT_SID=""
# Cash-on-delivery orders not confirmed within this many hours are cancelled
COD_CONFIRM_TTL_HOURS="48"

# Payments — UAE cards (Stripe Checkout, AED)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Payments — Pakistan. Each method appears at checkout only when its gateway is configured.
# JazzCash (merchant portal → Integrity Salt). Register pp_ReturnURL:
#   $NEXT_PUBLIC_APP_URL/api/payments/jazzcash/return
JAZZCASH_ENV="sandbox"              # sandbox | production
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
# Production inquiry URL is issued by JazzCash on approval; needed to resolve lost callbacks
JAZZCASH_INQUIRY_URL=""
# Optional overrides: JAZZCASH_CHECKOUT_URL, JAZZCASH_VERSION (1.1),
# JAZZCASH_WALLET_TXN_TYPE (MWALLET), JAZZCASH_CARD_TXN_TYPE (MPAY)

# Easypaisa / Easypay (merchant portal → Generate Hash Key; inquiry API credentials).
# IPN URL to configure: $NEXT_PUBLIC_APP_URL/api/payments/easypaisa/ipn
EASYPAISA_ENV="sandbox"             # sandbox | production
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""
EASYPAISA_USERNAME=""
EASYPAISA_PASSWORD=""
EASYPAISA_ACCOUNT_NUM=""
# Optional: EASYPAISA_BASE_URL override

# Which gateway processes Pakistani debit/credit cards: jazzcash | easypaisa
PK_CARD_GATEWAY="jazzcash"

PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Tabby / regional BNPL — configure in admin + env when integrating
TABBY_PUBLIC_KEY=""
TABBY_SECRET_KEY=""

# Realtime (run: npm run dev:all)
REALTIME_PORT="3001"
REALTIME_SECRET="dev-realtime-secret"
REALTIME_HTTP_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_REALTIME_URL="http://127.0.0.1:3001"

# Cron / internal jobs, called with header x-cron-secret:
#   POST /api/cron/expire-orders   every 10–15 min (resolve/cancel unpaid & unconfirmed orders)
#   POST /api/cron/abandoned-cart  daily
CRON_SECRET="change-me-cron"
